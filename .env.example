# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# For the setup page's "Sign in with Discord" (OAuth2 > Client Secret).
DISCORD_CLIENT_SECRET=
# Optional: register slash commands to one test server instantly instead of globally.
DISCORD_DEV_GUILD_ID=

# --- Database ----------------------------------------------------------------
# For local development. docker-compose.prod.yml builds its own from POSTGRES_PASSWORD below.
DATABASE_URL=postgres://dq:dq@localhost:5432/dq

# --- Secrets -----------------------------------------------------------------
# Comma-separated, newest first. Each key is 32 random bytes, base64.
# Generate one with: echo "v1:$(openssl rand -base64 32)"
MASTER_KEYS=v1:REPLACE_ME
# Public address of the setup page. Add WEB_BASE_URL/auth/callback as an OAuth2 redirect in the Developer Portal.
WEB_BASE_URL=http://localhost:3000

# --- Platform-default AI providers (optional; guilds can bring their own on the setup page) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Allow custom endpoints on private networks (e.g. Ollama on your LAN). Self-hosters only.
ALLOW_PRIVATE_ENDPOINTS=false

# --- Image storage (optional; defaults to Postgres) ---------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Docker Compose (docker-compose.prod.yml) ---------------------------------
# Database password, set once before the first start: openssl rand -hex 24
POSTGRES_PASSWORD=
# The setup page's domain, pointed at this server, for automatic HTTPS (the "https" profile).
# WEB_BASE_URL above must then be https://<DOMAIN>.
DOMAIN=
# Uncomment so plain `docker compose up -d` uses the production file with HTTPS:
# COMPOSE_FILE=docker-compose.prod.yml
# COMPOSE_PROFILES=https
