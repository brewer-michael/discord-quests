{
  "name": "discord-quests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "world:validate": "tsx tools/world-validate.ts",
    "sim": "pnpm --filter @dq/sim start",
    "writer": "pnpm --filter @dq/bot writer",
    "writer:stress": "tsx packages/engine/src/story-writer/stress.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "world:schemas": "tsx tools/gen-json-schemas.ts",
    "bestiary": "tsx tools/gen-bestiary.ts",
    "fight-rules": "tsx tools/fight-rules.ts",
    "web:dev": "pnpm --filter @dq/web dev",
    "web:build": "pnpm --filter @dq/web build",
    "e2e": "pnpm --filter @dq/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
