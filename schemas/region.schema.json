{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "biome": {
      "type": "string",
      "enum": [
        "village",
        "meadow",
        "forest",
        "marsh",
        "mountain",
        "coast",
        "desert",
        "fen",
        "ruins",
        "fortress",
        "volcano"
      ]
    },
    "terrain": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "levelBand": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 10
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "centroid": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "travelDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "road": {
            "type": "boolean"
          }
        },
        "required": ["to", "travelDays", "road"],
        "additionalProperties": false
      }
    },
    "pois": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "kind": {
            "type": "string",
            "enum": ["town", "landmark", "dungeon", "camp", "shrine", "secret"]
          },
          "at": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": ["id", "name", "description", "kind"],
        "additionalProperties": false
      }
    },
    "encounters": {
      "type": "object",
      "properties": {
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "table": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "creature": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "count": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 8
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["creature", "count", "weight"],
            "additionalProperties": false
          }
        }
      },
      "required": ["chance", "table"],
      "additionalProperties": false
    },
    "lootTable": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "secrets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "artPrompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "mood": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "biome",
    "terrain",
    "levelBand",
    "polygon",
    "centroid",
    "edges",
    "pois",
    "encounters",
    "artPrompt",
    "mood"
  ],
  "additionalProperties": false
}
