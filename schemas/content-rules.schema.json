{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hardLimits": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "levels": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "rules": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "substitutions": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "avoid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "prefer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": ["avoid", "prefer"],
                "additionalProperties": false
              }
            },
            "bannedTerms": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "required": ["description", "rules"],
          "additionalProperties": false
        },
        "classic": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "rules": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "substitutions": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "avoid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "prefer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": ["avoid", "prefer"],
                "additionalProperties": false
              }
            },
            "bannedTerms": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "required": ["description", "rules"],
          "additionalProperties": false
        },
        "epic": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "rules": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "substitutions": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "avoid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "prefer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": ["avoid", "prefer"],
                "additionalProperties": false
              }
            },
            "bannedTerms": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "required": ["description", "rules"],
          "additionalProperties": false
        }
      },
      "required": ["light", "classic", "epic"],
      "additionalProperties": false
    },
    "bannedTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  },
  "required": ["hardLimits", "levels", "bannedTerms"],
  "additionalProperties": false
}
