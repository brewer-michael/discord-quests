{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "enum": ["long-road", "quick-way"]
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "tagline": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "perks": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "effect": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "advantage_vs_condition"
                    },
                    "condition": {
                      "type": "string",
                      "enum": [
                        "blinded",
                        "charmed",
                        "frightened",
                        "grappled",
                        "invisible",
                        "poisoned",
                        "prone",
                        "restrained",
                        "stunned",
                        "dazed"
                      ]
                    }
                  },
                  "required": ["kind", "condition"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "reroll_failed_check"
                    },
                    "usesPerLongRest": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  },
                  "required": ["kind", "usesPerLongRest"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "help_bonus"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  },
                  "required": ["kind", "amount"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "temp_hp_on_rest"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    }
                  },
                  "required": ["kind", "amount"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "flavor"
                    }
                  },
                  "required": ["kind"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["id", "name", "description", "effect"],
          "additionalProperties": false
        }
      }
    },
    "required": ["id", "name", "tagline", "description", "perks"],
    "additionalProperties": false
  }
}
