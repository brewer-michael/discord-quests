{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sockets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "spared_one_acts",
              "ally_arrives",
              "knowledge_given",
              "trusted_at_need",
              "hidden_way",
              "object_reveals",
              "enemy_blunder",
              "ambush_avoided"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "narrationHint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "accepts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mercy",
                "honesty_at_cost",
                "patience",
                "promise_kept",
                "kindness_to_lowly",
                "self_sacrifice",
                "keepsake_kept",
                "amends"
              ]
            }
          }
        },
        "required": ["type", "label", "description", "narrationHint", "accepts"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sockets"],
  "additionalProperties": false
}
