{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "alignment": {
      "type": "string",
      "enum": ["long-road", "quick-way", "antagonist", "neutral"]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "goals": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "methods": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "leader": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "clocks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "segments": {
            "type": "integer",
            "minimum": 4,
            "maximum": 12
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "onFill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": ["id", "name", "segments", "description", "onFill"],
        "additionalProperties": false
      }
    },
    "startingDisposition": {
      "default": 0,
      "type": "integer",
      "minimum": -3,
      "maximum": 3
    }
  },
  "required": ["id", "name", "alignment", "description", "goals", "methods"],
  "additionalProperties": false
}
