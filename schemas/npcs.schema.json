{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "namePool": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "quirks": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "voice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "creature": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "faction": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": ["id", "label", "description", "namePool", "quirks", "voice"],
        "additionalProperties": false
      }
    },
    "named": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "archetype": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "region": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "faction": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "secret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "creature": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": ["id", "name", "archetype", "description", "region", "role"],
        "additionalProperties": false
      }
    }
  },
  "required": ["archetypes", "named"],
  "additionalProperties": false
}
