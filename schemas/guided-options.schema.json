{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "upbringings": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "scores": {
            "type": "object",
            "properties": {
              "str": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "dex": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "con": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "int": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "wis": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "cha": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": ["str", "dex", "con", "int", "wis", "cha"],
            "additionalProperties": false
          },
          "classAffinity": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": ["id", "label", "description", "scores", "classAffinity"],
        "additionalProperties": false
      }
    },
    "abilityFlavor": {
      "type": "object",
      "properties": {
        "str": {
          "type": "object",
          "properties": {
            "plus2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "plus1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": ["plus2", "plus1"],
          "additionalProperties": false
        },
        "dex": {
          "type": "object",
          "properties": {
            "plus2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "plus1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": ["plus2", "plus1"],
          "additionalProperties": false
        },
        "con": {
          "type": "object",
          "properties": {
            "plus2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "plus1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": ["plus2", "plus1"],
          "additionalProperties": false
        },
        "int": {
          "type": "object",
          "properties": {
            "plus2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "plus1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": ["plus2", "plus1"],
          "additionalProperties": false
        },
        "wis": {
          "type": "object",
          "properties": {
            "plus2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "plus1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": ["plus2", "plus1"],
          "additionalProperties": false
        },
        "cha": {
          "type": "object",
          "properties": {
            "plus2": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "plus1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": ["plus2", "plus1"],
          "additionalProperties": false
        }
      },
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "additionalProperties": false
    },
    "asiOptions": {
      "minItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "increments": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": ["str", "dex", "con", "int", "wis", "cha"]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          }
        },
        "required": ["id", "label", "description", "increments"],
        "additionalProperties": false
      }
    }
  },
  "required": ["upbringings", "abilityFlavor", "asiOptions"],
  "additionalProperties": false
}
